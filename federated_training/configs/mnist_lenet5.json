{
  "dataset": "mnist",
  "model": "lenet5",
  "num_clients": 1000,
  "active_clients": 800,
  "rounds": 300,
  "data_split": "iid",
  "local_epochs": 1,
  "batch_size": 32,
  "test_batch_size": 256,
  "learning_rate": 0.01,
