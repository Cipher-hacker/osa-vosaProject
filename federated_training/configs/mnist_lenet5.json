  "seed": 2026,
  "num_workers": 0,
  "quant_scale": 1000000.0,
  "clip_value": 0.1,
  "committee_size": 50,
  "reconstruction_threshold": 40,
  "opa_reconstruction_threshold": 34,
  "rss_secret_dim": 30,
  "protocol_chunk_size": 4096,
  "opa_chunk_size": 64,
  "rng_mode": "os_rng_security",
  "checkpoint_every": 1,
  "keep_bridge_artifacts": false
}
